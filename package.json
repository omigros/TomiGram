{
  "name": "tomigram",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram and VK desktop workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "test": "node --test test/navigation.test.cjs"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.tomigram.desktop",
    "productName": "TomiGram",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "ui/**/*",
      "upstream/abudjagram/src/assets/pattern.svg",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "TomiGram-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
